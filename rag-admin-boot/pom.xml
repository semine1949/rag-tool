<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>rag-vector-tool</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>rag-admin-boot</artifactId>
    <name>rag-admin-boot</name>
    <description>SpringBoot启动服务，对外HTTP API、批量任务、参数配置</description>

    <dependencies>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-chunker</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-embedding</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-weaviate</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
