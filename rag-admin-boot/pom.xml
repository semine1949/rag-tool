<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>rag-vector-tool</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>rag-admin-boot</artifactId>
    <name>rag-admin-boot</name>
    <description>SpringBoot启动服务，对外HTTP API、批量任务、参数配置</description>

    <dependencies>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-chunker</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-auth</artifactId>
        </dependency>

        <!-- Spring AI 基础接口（EmbeddingModel / VectorStore / Document / TextSplitter）随 rag-core 传递引入。
             具体连接器（OpenAI 兼容 Embedding、Weaviate）由 rag-core 基于接口自行实现，
             因 spring-ai-model-openai / spring-ai-vector-store-weaviate 连接器本地镜像中不可用。 -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- MyBatis -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
