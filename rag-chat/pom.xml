<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>rag-vector-tool</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>rag-chat</artifactId>
    <name>rag-chat</name>
    <description>Chat 会话层：会话生命周期管理、消息收发编排、上下文组织、文档对话，依赖 rag-config 能力层与 rag-auth 数据层</description>

    <dependencies>
        <!-- ===== 内部模块 ===== -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-auth</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Redis 会话存储（问答多轮对话上下文管理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Jackson JSON 序列化 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>