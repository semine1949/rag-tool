<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>rag-vector-tool</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>rag-config</artifactId>
    <name>rag-config</name>
    <description>装配与实现层：具体厂商适配器、模型工厂、向量库注册表、配置驱动实例化</description>

    <dependencies>
        <!-- 依赖 rag-common 抽象层 -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>rag-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Weaviate 直连客户端（多租户物理隔离集合） -->
        <dependency>
            <groupId>io.weaviate</groupId>
            <artifactId>client</artifactId>
            <version>4.6.0</version>
        </dependency>
        <!-- ===== Spring AI 官方连接器 starter ===== -->
        <!-- OpenAI 协议官方 SDK：OpenAiApi / OpenAiChatModel / OpenAiEmbeddingModel / OpenAiEmbeddingOptions -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- Ollama 协议官方 SDK：OllamaApi / OllamaChatModel / OllamaEmbeddingModel -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- DashScope（阿里云通义/百炼）官方 SDK：DashScopeApi / DashScopeChatModel / DashScopeEmbeddingModel。
             官方 Spring AI 无 dashscope starter，由 spring-ai-alibaba 体系提供；
             1.0.0.2 基于 Spring AI 1.0.0，与项目 spring-ai-bom:1.0.0 对齐，避免版本冲突。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <version>1.0.0.2</version>
        </dependency>

        <!-- OpenAI 兼容 Embedding HTTP 调用 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <!-- Jackson JSON 序列化 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
